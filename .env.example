# ================================================================
# Sao chép file này thành .env rồi điền thông tin thật vào
# cp .env.example .env
# ================================================================

# Supabase PostgreSQL connection string
# Lấy từ: Supabase Dashboard → Settings → Database → Connection string → URI
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxx:YourPasswordHere@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
